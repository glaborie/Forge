{
  "uid": "forge-reliability",
  "title": "Forge \u2014 AI Reliability",
  "tags": [
    "forge",
    "ai-reliability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "langfuse_project_url",
        "label": "Langfuse project URL",
        "type": "textbox",
        "query": "https://cloud.langfuse.com",
        "current": {
          "text": "https://cloud.langfuse.com",
          "value": "https://cloud.langfuse.com"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Traces in Langfuse",
      "url": "${langfuse_project_url}/traces",
      "type": "link",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "LLM latency P95 / P99 (s) \u2014 alert > 5s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "P95",
          "legendFormat": "P95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[$__rate_interval])))"
        },
        {
          "refId": "P99",
          "legendFormat": "P99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "LLM error rate \u2014 alert > 1%",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "error rate",
          "expr": "sum(rate(forge_llm_calls_total{error=\"true\"}[$__rate_interval])) / sum(rate(forge_llm_calls_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens per request \u2014 alert > 10,000",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "avg tokens",
          "expr": "sum(rate(gen_ai_client_token_usage_total[$__rate_interval])) / sum(rate(forge_llm_calls_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Cost per tenant (USD, window)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "expr": "sum by (tenant_id) (increase(forge_llm_cost_usd_total[$__range]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost per request (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "cost per request",
          "expr": "sum(rate(forge_llm_cost_usd_total[$__rate_interval])) / sum(rate(forge_llm_calls_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Calls by model and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{gen_ai_request_model}} error={{error}}",
          "expr": "sum by (gen_ai_request_model, error) (rate(forge_llm_calls_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Circuit-breaker trips \u2014 pending E1",
      "description": "No producer yet. E1 (circuit breakers and fallback behaviour) adds forge.circuit_breaker.trips; the alert rule in deploy/prometheus/alerts.yml is already written and commented out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "textMode": "value",
        "colorMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(0)"
        }
      ]
    }
  ]
}
