# Copy to .env and fill in. Never commit .env.
#
# Langfuse Cloud: Settings -> API Keys. The auth string is the base64 of
# "public_key:secret_key":
#   echo -n "pk-lf-...:sk-lf-..." | base64 -w 0
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
LANGFUSE_AUTH_STRING=

# Grafana login (anonymous viewer is enabled regardless)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
