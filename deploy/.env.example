# Copy to .env at the repository root (or deploy/.env) and fill in.
# Never commit it — .env is git-ignored.
#
# Langfuse Cloud: Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# https://cloud.langfuse.com (EU) | https://us.cloud.langfuse.com | https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: Grafana login (anonymous viewer is enabled regardless)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# deploy/up.sh turns the three Langfuse values into the two the collector reads:
#   LANGFUSE_OTLP_ENDPOINT=${LANGFUSE_BASE_URL}/api/public/otel
#   LANGFUSE_AUTH_STRING=base64(public_key:secret_key)
# Running `docker compose up` directly therefore needs those two exported too.
