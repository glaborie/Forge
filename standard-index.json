    "Every story.id in stories[] appears in exactly one epic in indexes.by_epic",
    "Every story.id in stories[] appears in exactly one milestone in indexes.by_milestone",
    "Every story.id in stories[] appears in exactly one priority bucket in indexes.by_priority",
    "Every standard referenced in primary_standards or supporting_standards is a key in standards_registry",
    "Every value in stories[].dimensions is in dimensions[]",
    "indexes.by_standard[std] equals the set of stories whose primary_standards or supporting_standards reference std",
    "indexes.by_dimension[dim] equals the set of stories whose dimensions includes dim"
  ],
  "example_queries": {
    "all_stories_for_owasp": "jq '.indexes.by_standard[\"OWASP LLM Top 10\"]' standards-index.json",
    "all_standards_for_story": "jq '.stories[] | select(.id==\"D3\") | [.primary_standards[].standard, .supporting_standards[].standard]' standards-index.json",
    "eu_ai_act_coverage": "jq '[.stories[] | select(any(.primary_standards[]?, .supporting_standards[]?; .standard==\"EU AI Act\")) | .id]' standards-index.json",
    "missing_owasp_controls": "jq --slurpfile reg <(jq '.standards_registry[\"OWASP LLM Top 10\"].controls | keys' standards-index.json) '[.stories[] | .primary_standards[]? | select(.standard==\"OWASP LLM Top 10\") | .refs[]] | unique' standards-index.json",
    "p0_stories_by_standard": "jq '[.stories[] | select(.priority==\"P0\") | {id, stds: [.primary_standards[].standard]}]' standards-index.json",
    "milestone_readiness": "jq '.indexes.by_milestone | to_entries | map({milestone: .key, count: (.value|length), stories: .value})' standards-index.json"
  }
